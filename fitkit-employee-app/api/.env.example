# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://fitkit:fitkit@localhost:5432/fitkit?sslmode=disable
ADDR=:8080
# HMAC secrets for webhooks (header X-Fitkit-Signature: sha256=<hex>)
CLIENT_APP_WEBHOOK_SECRET=change-me-client-app
TRACKER_WEBHOOK_SECRET=change-me-tracker
# Browser origin allowed by CORS; leave empty when the front-end goes through the Vite proxy
ALLOW_ORIGIN=
# true behind HTTPS
SECURE_COOKIE=false
# How often background jobs run (auto-refunds after 24 h, stalled parcels)
JOBS_INTERVAL=1m
# Port; hosting platforms set PORT instead
# ADDR=:8080
# Built front-end to serve (set in the Docker image)
# WEB_DIR=../web/dist
# First sign-in on an empty database (shift lead)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
